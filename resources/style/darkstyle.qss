}

/* QComboBox down-arrow - 使用border技巧绘制三角形箭头 */
BatteryControl QComboBox::down-arrow,
TranRecvUI QComboBox::down-arrow,
DataSaveUI QComboBox::down-arrow,
DataProcessUI QComboBox::down-arrow,
sigParamUI QComboBox::down-arrow,
