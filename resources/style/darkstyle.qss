 */

/* QLabel - ������ǩ��ʽ */
BatteryControl QLabel,
TranRecvUI QLabel,
DataSaveUI QLabel,
DataProcessUI QLabel,
sigParamUI QLabel,
FreqControlUI QLabel,
waveAndSample QLabel,
ScanRangeUI QLabel,
PhotoElectricParam QLabel,
ServoControl QLabel {
    background-color: transparent;
    color: #66ffcc;
    font-size: 14px;
    font-weight: bold;
    padding: 2px;
}

/* QCheckBox - checkbox style */
BatteryControl QCheckBox,
TranRecvUI QCheckBox,
DataSaveUI QCheckBox,
DataProcessUI QCheckBox,
sigParamUI QCheckBox,
FreqControlUI QCheckBox,
waveAndSample QCheckBox,
ScanRangeUI QCheckBox,
PhotoElectricParam QCheckBox,
ServoControl QCheckBox,
MousePositionInfo QCheckBox {
    color: #66ffcc;
    font-size: 14px;
    font-weight: bold;
    spacing: 8px;
}

/* QCheckBox indicator */
BatteryControl QCheckBox::indicator,
TranRecvUI QCheckBox::indicator,
DataSaveUI QCheckBox::indicator,
DataProcessUI QCheckBox::indicator,
sigParamUI QCheckBox::indicator,
FreqControlUI QCheckBox::indicator,
waveAndSample QCheckBox::indicator,
ScanRangeUI QCheckBox::indicator,
PhotoElectricParam QCheckBox::indicator,
ServoControl QCheckBox::indicator,
MousePositionInfo QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #66ffcc;
    border-radius: 4px;
    background-color: rgba(16, 24, 24, 0.8);
}

/* QCheckBox checked - 使用对勾图标 */
BatteryControl QCheckBox::indicator:checked,
TranRecvUI QCheckBox::indicator:checked,
DataSaveUI QCheckBox::indicator:checked,
DataProcessUI QCheckBox::indicator:checked,
sigParamUI QCheckBox::indicator:checked,
FreqControlUI QCheckBox::indicator:checked,
waveAndSample QCheckBox::indicator:checked,
ScanRangeUI QCheckBox::indicator:checked,
PhotoElectricParam QCheckBox::indicator:checked,
ServoControl QCheckBox::indicator:checked,
MousePositionInfo QCheckBox::indicator:checked {
    background-color: #66ffcc;
    border: 2px solid #66ffcc;
    border-radius: 4px;
    image: url(:/resources/images/checkbox_checked.svg);
}

/* QCheckBox hover */
BatteryControl QCheckBox::indicator:hover,
TranRecvUI QCheckBox::indicator:hover,
DataSaveUI QCheckBox::indicator:hover,
DataProcessUI QCheckBox::indicator:hover,
sigParamUI QCheckBox::indicator:hover,
FreqControlUI QCheckBox::indicator:hover,
waveAndSample QCheckBox::indicator:hover,
ScanRangeUI QCheckBox::indicator:hover,
PhotoElectricParam QCheckBox::indicator:hover,
ServoControl QCheckBox::indicator:hover,
MousePositionInfo QCheckBox::indicator:hover {
    border-color: rgba(102, 255, 204, 0.8);
    background-color: rgba(102, 255, 204, 0.1);
}

/* ============================================
 * 状态信息栏专属样式 - 更大更醒目的开关控件
 * ============================================ */
#infoWidget QCheckBox {
    color: #66ffcc;              /* 青绿色科技感文字 */
    font-size: 18px;             /* 更大字体：18px（普通14px） */
    font-weight: bold;           /* 粗体 */
    spacing: 10px;               /* 文字与复选框间距 */
}

#infoWidget QCheckBox::indicator {
    width: 24px;                               /* 更大指示器：24x24（普通20x20） */
    height: 24px;
    border: 2px solid #66ffcc;                 /* 青绿色边框 */
    border-radius: 4px;                        /* 圆角 */
    background-color: rgba(16, 24, 24, 0.8);   /* 深色半透明背景 */
}

#infoWidget QCheckBox::indicator:checked {
    background-color: #66ffcc;                 /* 选中时青绿色填充 */
    border: 2px solid #66ffcc;
    border-radius: 4px;
    image: url(:/resources/images/checkbox_checked.svg);  /* 对勾图标 */
}

#infoWidget QCheckBox::indicator:hover {
    border-color: rgba(102, 255, 204, 0.8);    /* 悬停时边框半透明 */
    background-color: rgba(102, 255, 204, 0.1); /* 轻微高亮背景 */
}

