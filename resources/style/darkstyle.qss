/* V7.0 石墨灰 / 冷青主题，字号由 setupStyle 统一缩放一次。
 * 不给所有 QWidget 设置背景，保护主 PPI 下方的地图透明层。
 * 布局尺寸、数据颜色、点迹绘制与显示节拍由原代码管理。
 */
QWidget { color:#e8edf1; }
QLabel { background:transparent; }
QDialog, QMessageBox { background:#12171c; }
QLabel:disabled { color:#8e9ba6; }

/* 地图铺满主窗口：侧栏容器不填色，只给各信息面板一层半透明石墨底。 */
#LeftSidebar, #RightSidebar { background:transparent; }
#LogoWidget, #mainviewTopLeft, #MousePositionInfo, #PPIVisualSettings,
#mainPview #PPIVisualSettings, #PointInfoW, #timeLabel {
    background:rgba(18,23,28,178); border:1px solid #303b44; border-radius:5px;
}
#LogoWidget, #timeLabel { padding:6px 10px; }
#mainPview, #ZoomView, #sectorView { background:transparent; border:none; }
#pviewFitW, #pviewZoomW, #pviewSectorW, #RangeAzimuthChartWidget {
    background:rgba(18,23,28,150); border:1px solid #303b44; border-radius:5px;
}
#DisplayTabWidget { background:transparent; border:1px solid #303b44; border-radius:5px; }
#TitleLabel, #dTitleLabel { color:#e8edf1; font-size:18px; font-weight:bold; }
#SubtitleLabel { color:#a6b2bd; font-size:15px; margin-top:-2px; }
#timeLabel { color:#c4ced7; font-size:20px; }
#TitleBar { background:#1b2228; border:none; border-bottom:1px solid #303b44; min-height:40px; }
#mainviewTopLeft QLabel, #PointInfoW QLabel { color:#a6b2bd; font-size:18px; font-weight:normal; }
#MousePositionInfo QLabel { color:#a6b2bd; font-size:16px; }
#PPIVisualSettings QLabel { color:#a6b2bd; font-size:14px; }
#PointInfoW QLabel#batch, #PointInfoW QLabel#range, #PointInfoW QLabel#azi,
#PointInfoW QLabel#ele, #PointInfoW QLabel#altitute, #PointInfoW QLabel#speed,
#PointInfoW QLabel#SNR, #PointInfoW QLabel#targetRec { color:#e8edf1; font-size:18px; }
#stalabel1, #stalabel2, #stalabel3, #stalabel4, #stalabel5 { color:#a6b2bd; font-size:14px; }
#stamsg1, #stamsg2, #stamsg3, #stamsg4, #stamsg5 { color:#e8edf1; font-size:14px; }

/* 交互态保持相同边框宽度，避免悬停时控件跳动。 */
QPushButton, QToolButton {
    color:#e8edf1; background:#222c33; border:1px solid #3b4a55;
    border-radius:4px; padding:8px 20px; font-size:14px;
}
QPushButton:hover, QToolButton:hover { background:#293b44; border-color:#78cbd8; }
QPushButton:pressed, QToolButton:pressed { background:#23414a; border-color:#78cbd8; }
QPushButton:focus, QToolButton:focus { border-color:#78cbd8; }
QPushButton:checked, QToolButton:checked { background:#23414a; border-color:#78cbd8; color:#c2e8ed; }
QPushButton:disabled, QToolButton:disabled { background:#1b232a; color:#8e9ba6; border-color:#303b44; }
QToolButton[buttonGroup="A"] { font-size:14px; padding:8px 20px; }
#FuncWidget { background:rgba(18,23,28,140); border:1px solid #303b44; border-radius:5px; padding:8px 16px; }
QPushButton#minButton, QPushButton#CloseButton { padding:4px; margin:2px; }
#cMinButton, #cMaxButton, #cCloseBtn, #DetachBtn {
    background:transparent; border:1px solid transparent; padding:2px; margin:2px; border-radius:4px;
}
#cMinButton:hover, #cMaxButton:hover, #DetachBtn:hover { background:#293b44; border-color:#78cbd8; }
#cCloseBtn:hover, QPushButton#CloseButton:hover { background:#432932; border-color:#ce7682; color:#ea8c93; }
#cCloseBtn:pressed, QPushButton#CloseButton:pressed { background:#56313b; border-color:#ea8c93; }

/* 非当前页签保持中性，位置、顺序、显隐仍由现有代码控制。 */
QTabWidget, QTabBar { background:transparent; border:none; }
QTabWidget::pane { background:#1b2228; border:1px solid #303b44; border-radius:4px; }
QTabBar::tab {
    background:#1b2228; color:#a6b2bd; font-size:13px; padding:6px 12px; margin:3px 4px;
    border:1px solid transparent; border-bottom:2px solid transparent; border-radius:3px;
}
QTabBar::tab:hover { color:#e8edf1; background:#222c33; }
QTabBar::tab:selected { color:#78cbd8; background:#26353d; border-bottom-color:#78cbd8; }
QTabBar::tab:disabled { color:#6e808c; }
QWidget#tab1, QWidget#tab_2, QWidget#tab_3, QWidget#tab_4, QWidget#tab_5, QWidget#tab { background:#1b2228; border:none; }

/* 仅覆盖主屏组件；独立窗口继续使用实底，避免多层半透明叠加后重新变成黑墙。 */
#LeftSidebar QTabWidget::pane, #RightSidebar QTabWidget::pane { background:transparent; }
#LeftSidebar #setTab::pane { background:rgba(18,23,28,128); }
#LeftSidebar QWidget#tab_2, #LeftSidebar QWidget#tab_3,
#LeftSidebar QWidget#tab_4, #LeftSidebar QWidget#tab_5,
#LeftSidebar QWidget#tab, #LeftSidebar QWidget#droneTrackTab { background:transparent; }
#LeftSidebar QTabBar::tab, #RightSidebar QTabBar::tab { background:rgba(27,34,40,150); }
#LeftSidebar QTabBar::tab:hover, #RightSidebar QTabBar::tab:hover { background:rgba(34,44,51,190); }
#LeftSidebar QTabBar::tab:selected, #RightSidebar QTabBar::tab:selected { background:rgba(38,53,61,210); }
#LeftSidebar QPushButton, #RightSidebar QPushButton,
#LeftSidebar QToolButton, #RightSidebar QToolButton,
#MousePositionInfo QPushButton, #PPIVisualSettings QPushButton {
    background:rgba(27,34,40,100);
}
#LeftSidebar QPushButton:hover, #RightSidebar QPushButton:hover,
#LeftSidebar QToolButton:hover, #RightSidebar QToolButton:hover,
#MousePositionInfo QPushButton:hover, #PPIVisualSettings QPushButton:hover { background:rgba(41,59,68,205); }
#LeftSidebar QPushButton:pressed, #RightSidebar QPushButton:pressed,
#LeftSidebar QToolButton:pressed, #RightSidebar QToolButton:pressed { background:rgba(35,65,74,225); }
#LeftSidebar QToolButton:checked, #RightSidebar QToolButton:checked { background:rgba(35,65,74,215); }
#LeftSidebar QPushButton:disabled, #RightSidebar QPushButton:disabled,
#LeftSidebar QToolButton:disabled, #RightSidebar QToolButton:disabled { background:rgba(27,35,42,100); }

/* 输入控件继承原字段精度/校验规则；只读与不可用状态分开表达。 */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, CustomComboBox {
    background:#141c22; color:#e8edf1; border:1px solid #3b4a55; border-radius:4px;
    padding:3px 6px; font-size:14px; selection-background-color:#2e4b57; selection-color:#ffffff;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover { border-color:#657d8c; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color:#78cbd8; }
QLineEdit[readOnly="true"] { color:#c4ced7; background:#202a32; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled { color:#8e9ba6; background:#1b232a; border-color:#303b44; }
QComboBox, CustomComboBox { padding-right:22px; }
QComboBox::drop-down { width:18px; border:none; border-left:1px solid #303b44; }
QComboBox::down-arrow { image:url(:/resources/icon/ui/chevron-down.svg); width:10px; height:10px; }
QComboBox QAbstractItemView { background:#1b2228; color:#e8edf1; border:1px solid #3b4a55; selection-background-color:#2e4b57; selection-color:#ffffff; padding:3px; }
QComboBox QAbstractItemView::item { min-height:22px; padding:3px 6px; }
QSpinBox::up-button, QDoubleSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::down-button { width:16px; background:#222c33; border:none; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image:url(:/resources/icon/ui/chevron-up.svg); width:9px; height:7px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image:url(:/resources/icon/ui/chevron-down.svg); width:9px; height:7px; }
#mainviewTopLeft QLineEdit { font-size:18px; padding:4px; }
#PPIVisualSettings QLineEdit, #PPIVisualSettings QComboBox { font-size:14px; padding:2px 4px; }
#PPIVisualSettings QComboBox { padding-right:20px; min-width:60px; }
#MousePositionInfo QDoubleSpinBox { font-size:14px; padding:2px 4px; }
#MousePositionInfo QDoubleSpinBox, #PPIVisualSettings QLineEdit,
#PPIVisualSettings QComboBox { background:rgba(18,23,28,85); }
#MousePositionInfo QDoubleSpinBox::up-button, #MousePositionInfo QDoubleSpinBox::down-button { background:rgba(34,44,51,85); }
#workModeTab QLabel#workModeLabel { font-size:16px; color:#a6b2bd; }
#workModeTab CustomComboBox#workModeCombo { font-size:16px; min-width:100px; padding:5px 22px 5px 8px; }
QCheckBox, QRadioButton { color:#c4ced7; spacing:6px; background:transparent; }
QCheckBox::indicator { width:14px; height:14px; border:1px solid #657d8c; border-radius:3px; background:#141c22; }
QCheckBox::indicator:hover { border-color:#78cbd8; }
QCheckBox::indicator:checked { image:url(:/resources/icon/ui/check.svg); background:#78cbd8; border-color:#78cbd8; }
QCheckBox::indicator:disabled { border-color:#3b4a55; background:#222c33; }
QCheckBox::indicator:indeterminate { background:#2e4b57; border-color:#78cbd8; }
QRadioButton::indicator { width:14px; height:14px; border:1px solid #657d8c; border-radius:7px; background:#141c22; }
QRadioButton::indicator:checked { background:#78cbd8; border:3px solid #2e4b57; }
QGroupBox { border:1px solid #303b44; border-radius:5px; margin-top:14px; padding:12px 8px 8px; }
QGroupBox::title { subcontrol-origin:margin; left:10px; color:#c4ced7; padding:0 4px; }

/* 表格保留拖拽列宽和行状态代理，仅统一底色/表头/选中态。 */
QTextEdit, QPlainTextEdit, QListWidget, QTableView, QTreeView {
    background:#12171c; alternate-background-color:#1b2228; color:#e8edf1;
    border:1px solid #303b44; border-radius:4px; selection-background-color:#2e4b57;
    selection-color:#ffffff; gridline-color:#303b44;
}
QTextEdit#logEdit { color:#c4ced7; font-size:12px; }
QTableWidget { font-size:14px; }
QHeaderView { background:#222c33; }
QHeaderView::section { background:#222c33; color:#a6b2bd; border:none; border-bottom:1px solid #3b4a55; padding:4px; font-size:13px; font-weight:normal; }
QTableCornerButton::section { background:#222c33; border:none; }
/* 单元格不额外铺实底；使用表格 Base/AlternateBase，行画刷保留作无 QSS 回退。 */
QTableWidget::item { border-bottom:1px solid #2b343d; padding:4px 8px; color:#e8edf1; }
QTableWidget::item:selected, QListWidget::item:selected, QTreeView::item:selected { background:#2e4b57; color:#ffffff; }
QTextEdit#logEdit, #LeftSidebar QTableWidget {
    background:rgba(18,23,28,216); alternate-background-color:rgba(27,34,40,32);
}
#LeftSidebar QTableWidget::item:selected { background:rgba(46,75,87,232); }
#LeftSidebar QHeaderView { background:transparent; }
#LeftSidebar QHeaderView::section, #LeftSidebar QTableCornerButton::section { background:rgba(34,44,51,220); }
QScrollBar:vertical { background:#12171c; width:10px; margin:0; border:none; }
QScrollBar:horizontal { background:#12171c; height:10px; margin:0; border:none; }
QScrollBar::handle:vertical { background:#465864; border-radius:4px; min-height:20px; margin:1px; }
QScrollBar::handle:horizontal { background:#465864; border-radius:4px; min-width:20px; margin:1px; }
QScrollBar::handle:hover { background:#657d8c; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height:0; border:none; background:none; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width:0; border:none; background:none; }
QScrollBar::add-page, QScrollBar::sub-page { background:transparent; }
#LeftSidebar QScrollBar { background:rgba(18,23,28,75); }
QMenu { background:#1b2228; color:#e8edf1; border:1px solid #3b4a55; padding:4px; }
QMenu::item { padding:6px 24px 6px 12px; }
QMenu::item:selected { background:#2e4b57; color:#ffffff; }
QMenu::item:disabled { color:#8e9ba6; }
QMenu::separator { height:1px; background:#303b44; margin:4px 8px; }
QToolTip { background:#222c33; color:#e8edf1; border:1px solid #657d8c; padding:6px; font-size:13px; }

/* 图表工具区；数据层不使用这些颜色。 */
#RangeAzimuthChartToolBar, #Track3DToolBar { background:rgba(27,34,40,110); border:none; border-bottom:1px solid #303b44; }
#RangeAzimuthChart, #Track3DWidget { background:#12171c; border:none; }
#RangeAzimuthChartToolBar QLabel, #Track3DToolBar QLabel { color:#a6b2bd; font-size:12px; }
#RangeAzimuthChartToolBar QPushButton, #Track3DToolBar QPushButton { font-size:12px; padding:3px 9px; border-radius:3px; }
#RangeAzimuthChartToolBar QLineEdit { font-size:12px; padding:3px 5px; }
#RangeAzimuthChartToolBar QFrame[frameShape="4"] { color:#3b4a55; background:#3b4a55; max-width:1px; }
#ZoomViewW QPushButton { padding:2px; margin:1px; border:1px solid transparent; background:transparent; }
#ZoomViewW QPushButton:hover { background:#293b44; border-color:#78cbd8; }
#ZoomViewW QPushButton:checked { background:#23414a; border-color:#78cbd8; }
QLabel#ZoomLabel { color:#c4ced7; font-size:16px; }
#SectorWidget QPushButton { padding:3px 8px; font-size:12px; }
#SectorWidget QLabel { color:#a6b2bd; font-size:12px; }
#SectorWidget QLineEdit { padding:3px; font-size:12px; }

/* 已有参数及总控窗口继续复用原入口、字段和顺序。 */
#TASModeDialog, #CommandControlWindow, #CommandControlRecordPage { background:#12171c; }
#TASModeDialog QLabel, PhotoElectricParam QLabel, ServoControl QLabel { color:#c4ced7; font-size:16px; }
#TASModeDialog QLineEdit, #TASModeDialog QComboBox, PhotoElectricParam QLineEdit,
ServoControl QLineEdit, ServoControl QDoubleSpinBox, ServoControl QComboBox { font-size:16px; padding:5px 8px; }
#TASModeDialog QComboBox, ServoControl QComboBox { padding-right:22px; }
#CommandControlTitleBar { background:#1b2228; border-bottom:1px solid #303b44; }
#CommandControlTitleLabel { color:#e8edf1; font-size:20px; font-weight:bold; }
#CommandControlWindow QLabel { color:#c4ced7; }
#CommandControlStatusLabel { background:#1b2228; color:#a6b2bd; border:1px solid #303b44; padding:8px; }
#CommandControlWindow QPushButton { padding:6px 12px; font-size:14px; }
#CommandControlTimeSyncButton, #CommandControlApplyAutoRangeButton { color:#78cbd8; }
#CommandControlStopReplayButton { color:#ea8c93; }
#CommandControlPauseReplayButton { color:#d8bd80; }

/* 健康卡片/列表由 HealthUi 控件分层排版，不改变故障判定。 */
#HealthScrollArea, #HealthViewport, QWidget[healthPanelPage="true"] { background:#12171c; border:none; }
#HealthContent QLabel { color:#a6b2bd; background:transparent; }
#HealthContent QLabel[healthHeading="true"] { color:#e8edf1; font-size:18px; font-weight:bold; }
#HealthContent QTabWidget::pane { background:#12171c; }

/* 回放控件继续保留录制中的红色语义。 */
#FrameInfoLabel, #RecorderQualityLabel { color:#a6b2bd; font-size:13px; }
#RecorderSectionLabel { color:#e8edf1; font-size:14px; font-weight:bold; }
#RecorderPreview, #RecorderFileList { background:#12171c; border:1px solid #303b44; border-radius:4px; }
#RecorderFileList::item { padding:6px; }
#RecorderFileList::item:hover { background:#222c33; }
#RecorderFileList::item:selected { background:#2e4b57; }
#RefreshBtn { padding:4px 10px; font-size:13px; }
#RecordBtn[recording="true"] { background:#35252d; color:#ea8c93; border-color:#ce7682; }
#RecorderSlider::groove:horizontal { height:4px; background:#303b44; border-radius:2px; }
#RecorderSlider::handle:horizontal { background:#78cbd8; width:12px; margin:-4px 0; border-radius:5px; }
#RecorderSlider::sub-page:horizontal { background:#408b9b; }
#RecorderQualityCombo { padding:4px 22px 4px 6px; font-size:13px; min-width:90px; }
