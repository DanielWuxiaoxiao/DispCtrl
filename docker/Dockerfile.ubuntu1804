FROM ubuntu:18.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

RUN apt-get update \
    && apt-get install -y --no-install-recommends software-properties-common gpg-agent wget ca-certificates \
    && add-apt-repository ppa:ubuntu-toolchain-r/test -y \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc-9 g++-9 make pkg-config \
        libgl1-mesa-dev libxkbcommon-dev libfontconfig1-dev \
        libxcb-xinerama0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xfixes0 \
        libxcb-sync1 patchelf tar gzip \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-9 90 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-9 90 \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-py39_4.12.0-Linux-x86_64.sh -O /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p /opt/miniconda \
    && rm /tmp/miniconda.sh
ENV PATH="/opt/miniconda/bin:${PATH}"

RUN pip install --no-cache-dir --upgrade pip setuptools \
    && pip install --no-cache-dir cmake ninja "aqtinstall<3.2" patchelf \
    && aqt install-qt linux desktop 5.15.2 gcc_64 --outputdir /opt/Qt

ENV QT_ROOT=/opt/Qt/5.15.2/gcc_64
ENV CMAKE_PREFIX_PATH=${QT_ROOT}
ENV PATH="${QT_ROOT}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${QT_ROOT}/lib"
ENV DISPCTRL_BUNDLE_STDCPP=1

WORKDIR /src

CMD ["/bin/bash", "-c", "cd /src && bash scripts/build_linux.sh Release && bash scripts/package_linux.sh Release && if [ -d /output ]; then cp deploy/DispCtrl-linux-x64.tar.gz /output/; fi"]
