ARG UBUNTU_VERSION=20.04
FROM ubuntu:${UBUNTU_VERSION}

ARG UBUNTU_VERSION
ARG OPENSSL_PACKAGE=libssl1.1
ARG ALSA_PACKAGE=libasound2
ENV DEBIAN_FRONTEND=noninteractive

COPY docker/offline_deps_packages.txt /tmp/offline_deps_packages.txt

# Ubuntu 18.04 is EOL. Pin its repository snapshot so the offline package set
# can still be reproduced; newer Ubuntu images keep their normal sources.
RUN if [ "${UBUNTU_VERSION}" = "18.04" ]; then \
        sed -i \
            -e "s|http://archive.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/20230327T000000Z/|g" \
            -e "s|http://security.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/20230327T000000Z/|g" \
            -e "s|https://archive.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/20230327T000000Z/|g" \
            -e "s|https://security.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/20230327T000000Z/|g" \
            /etc/apt/sources.list; \
        apt-get -o Acquire::https::Verify-Peer=false \
            -o Acquire::https::Verify-Host=false update; \
        apt-get -o Acquire::https::Verify-Peer=false \
            -o Acquire::https::Verify-Host=false install -y --no-install-recommends ca-certificates; \
    else \
        apt-get update; \
        apt-get install -y --no-install-recommends ca-certificates; \
    fi \
    && apt-get update \
    && { grep -vE '^[[:space:]]*(#|$)' /tmp/offline_deps_packages.txt; echo "${OPENSSL_PACKAGE}"; echo "${ALSA_PACKAGE}"; } \
        | xargs apt-get -y --download-only --reinstall install \
    && mkdir -p /opt/offline-debs \
    && find /var/cache/apt/archives -maxdepth 1 -type f -name '*.deb' -exec cp {} /opt/offline-debs/ \; \
    && for package in /opt/offline-debs/*.deb; do \
        dpkg-deb -f "$package" Package Version Architecture; \
       done > /opt/offline-debs/PACKAGES.txt

CMD ["/bin/bash", "-c", "set -e; mkdir -p /output; cp -a /opt/offline-debs/. /output/; echo 'Offline runtime packages exported to /output.'"]
